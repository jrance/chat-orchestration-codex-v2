APP_NAME=codeless-orch
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# Tenant & downstream header defaults (used later; present here for dev ergonomics)
DEFAULT_TENANT_ID=demo-tenant
APIGEE_CLIENT_ID=replace-me
APIGEE_TOKEN_URL=https://gateway.example.com/oauth2/token

# Logging
LOG_LEVEL=INFO
LOG_REDACTION_ENABLED=false

# Apigee client secret (set in real environments)
APIGEE_CLIENT_SECRET=replace-me
APIGEE_SCOPES=openid offline_access
APIGEE_AUDIENCE=https://gateway.example.com/apis/openai

# Base URL for the OpenAI-compatible endpoint proxied by Apigee
OPENAI_BASE_URL=https://gateway.example.com/openai
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
HTTP_RETRY_BACKOFF_MS=250

# Optional extra headers as JSON (merged into every outbound request)
APIGEE_EXTRA_HEADERS_JSON={"X-Channel":"orchestrator","X-App":"codeless-orch"}

# HTTP client tuning (legacy knobs remain supported; defaults derive from HTTP_TIMEOUT_SECONDS when unset)
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=60.0
HTTP_WRITE_TIMEOUT=60.0
HTTP_POOL_MAX_CONNECTIONS=100
HTTP_POOL_MAX_KEEPALIVE=20
HTTP_RETRY_MAX_ATTEMPTS=3
HTTP_RETRY_BASE_DELAY=0.2

# Optional local debugging proxy configuration
PROXY_ENABLED=false
PROXY_URL=http://127.0.0.1:8888
# PROXY_CA_BUNDLE=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

# (Optional) Override schema location
ORCH_SCHEMA_PATH=schemas/orchestration_ir.schema.json

# Org preamble for prompts (choose one)
ORG_PREAMBLE_PATH=docs/org_preamble.md
# OR: set inline text instead of a file
# ORG_PREAMBLE_TEXT=Our organization values clarity and privacy...

# Checkpointer selection: memory | (redis|sql in future)
CHECKPOINTER_KIND=memory
CHECKPOINTER_BACKEND=memory

# Run state store selection: memory | (redis|sql in future)
RUN_STORE_KIND=memory

# Redis emulator configuration (used when CHECKPOINTER_BACKEND=redis)
REDIS_URL=fakeredis://
REDIS_EMULATOR=true
